{
  "info": {
    "name": "Todo API",
    "description": "CRUD tests for the Todo RESTful API (AdonisJS 5 + PostgreSQL).\n\nRun the whole collection in order (Collection Runner or `newman`). Requests chain through the `todoId` variable, so run them in sequence on a migrated database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3333",
      "type": "string"
    },
    {
      "key": "todoId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "pm.test('API and database are healthy', () => pm.expect(pm.response.json().healthy).to.eql(true));",
              "pm.test('Response time is under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verifies that the API is up and can reach the database."
      },
      "response": []
    },
    {
      "name": "Root endpoint",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const res = pm.response.json();",
              "pm.test('API reports name and ok status', () => {",
              "  pm.expect(res.name).to.eql('Todo API');",
              "  pm.expect(res.status).to.eql('ok');",
              "});",
              "pm.test('Response time is under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Verifies that the API root endpoint responds with service name and status."
      },
      "response": []
