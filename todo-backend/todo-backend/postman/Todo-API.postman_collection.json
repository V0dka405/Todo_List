        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const todos = pm.response.json();",
              "pm.test('Body is an array', () => pm.expect(todos).to.be.an('array'));",
              "pm.test('List contains the todo created earlier', () => {",
              "  const id = Number(pm.collectionVariables.get('todoId'));",
              "  pm.expect(todos.map((t) => t.id)).to.include(id);",
              "});",
              "pm.test('Newest todo comes first', () => {",
              "  const ids = todos.map((t) => t.id);",
              "  pm.expect(ids).to.eql([...ids].sort((a, b) => b - a));",
              "});",
              "pm.test('Response time is under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
