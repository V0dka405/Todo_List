    {
      "name": "1. Create todo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const todo = pm.response.json();",
              "pm.test('Todo has the expected fields', () => {",
              "  pm.expect(todo).to.include.keys('id', 'title', 'completed', 'createdAt', 'updatedAt');",
              "  pm.expect(todo.id).to.be.a('number');",
              "  pm.expect(todo.title).to.be.a('string');",
              "  pm.expect(todo.completed).to.be.a('boolean');",
              "});",
              "pm.test('Title is trimmed and todo starts uncompleted', () => {",
              "  pm.expect(todo.title).to.eql('Buy milk');",
              "  pm.expect(todo.completed).to.eql(false);",
              "});",
              "pm.collectionVariables.set('todoId', todo.id);",
              "pm.test('Response time is under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "todos"
          ]
        },
        "description": "Create (C). The title is trimmed by the server. Saves the new id in the `todoId` collection variable for the next requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"  Buy milk  \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
