              "pm.test('Status is 422 Unprocessable Entity', () => pm.response.to.have.status(422));",
              "pm.test('Content-Type is JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
              "const body = pm.response.json();",
              "pm.test('Error body describes the validation failure', () => {",
              "  pm.expect(body.code).to.eql('E_VALIDATION_FAILURE');",
              "  pm.expect(body.message).to.be.a('string');",
              "});",
              "pm.test('Error points at the \"title\" field', () => {",
              "  pm.expect(body.errors.map((e) => e.field)).to.include('title');",
              "});",
              "pm.test('Response time is under 3000ms', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
